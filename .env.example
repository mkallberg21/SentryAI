# SentryAI — example environment. NEVER commit real values.
NODE_ENV=development

# Envelope encryption. In production these come from a KMS (AWS KMS / GCP KMS),
# never from environment variables. This is for local development only.
SENTRYAI_LOCAL_KEK=

# Postgres
DATABASE_URL=postgres://sentryai:sentryai@localhost:5432/sentryai

# Model provider. Student data is never sent to a provider without a signed
# no-training agreement; see docs/ai-governance.md.
ANTHROPIC_API_KEY=
